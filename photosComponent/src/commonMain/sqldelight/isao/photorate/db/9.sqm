-- Drops the unused contentHash/width/height/handCount columns from
-- GalleryImage. modifiedAt (MediaStore DATE_MODIFIED) now drives the rescan
-- decision in the insertOrUpdateImage upsert. SQLite on Android 11 (< 3.35)
-- cannot DROP COLUMN, so the table is recreated instead. Foreign keys are off
-- during SQLDelight's onUpgrade (Android enables them in onOpen afterwards),
-- so the DROP TABLE below does not cascade-delete DetectedHand/ImageEmbedding
-- rows; the RENAME re-points their REFERENCES clauses to the new table.
CREATE TABLE GalleryImage_new (
    uri TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    modifiedAt INTEGER NOT NULL,
    status TEXT AS GalleryImageStatus NOT NULL DEFAULT 'PENDING',
    scannedAt INTEGER,
    detectedInMs INTEGER
);

INSERT INTO GalleryImage_new(uri, createdAt, modifiedAt, status, scannedAt, detectedInMs)
SELECT uri, createdAt, modifiedAt, status, scannedAt, detectedInMs FROM GalleryImage;

DROP TABLE GalleryImage;

ALTER TABLE GalleryImage_new RENAME TO GalleryImage;
