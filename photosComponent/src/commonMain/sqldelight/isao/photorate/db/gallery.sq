import isao.photorate.db.GalleryImageStatus;
import isao.photorate.galleryRepository.DateHeaderMode;
import isao.photorate.galleryRepository.GallerySorting;
import isao.photorate.photosComponent.classify.LandmarkedImage.Point;
import isao.photorate.photosComponent.classify.Score;
import kotlin.Boolean;
import kotlin.FloatArray;
import kotlin.collections.List;

-- GalleryImage: one row per scanned image. Scan results (status/scannedAt/
-- detectedInMs) live here; the detected hands themselves are DetectedHand rows.
CREATE TABLE GalleryImage (
    uri TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    modifiedAt INTEGER NOT NULL,
    status TEXT AS GalleryImageStatus NOT NULL DEFAULT 'PENDING',
    scannedAt INTEGER,
    detectedInMs INTEGER
);

-- One row per status with its count, in one query.
countsByStatus:
SELECT status, COUNT(*) AS count
FROM GalleryImage
GROUP BY status;

-- Single status count, if you just need one number (e.g. a badge).
countForStatus:
SELECT COUNT(*)
FROM GalleryImage
WHERE status = ?;

-- Total row count, handy alongside the breakdown.
totalCount:
SELECT COUNT(*)
FROM GalleryImage;

-- DetectedHand: one row per detected hand (only inserted when hands found)
CREATE TABLE DetectedHand (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    imageUri TEXT NOT NULL,
    handIndex INTEGER NOT NULL,
    score REAL AS Score NOT NULL,
    bboxMinX REAL NOT NULL,
    bboxMinY REAL NOT NULL,
    bboxMaxX REAL NOT NULL,
    bboxMaxY REAL NOT NULL,
    bboxAreaFraction REAL NOT NULL,
    centroidX REAL NOT NULL,
    centroidY REAL NOT NULL,
    points TEXT AS List<Point> NOT NULL,
    -- Set for hands rated at reduced confidence (ONNX uncertain tier): the
    -- score is a best guess the user should review.
    uncertain INTEGER AS Boolean NOT NULL DEFAULT 0, --TODO store degree of certainty instead
    -- Set when the score was entered by the user (fake hand) instead of
    -- detected. Real detections are kept alongside for statistics; the UI
    -- shows the user rating when one is present.
    isUserRated INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (imageUri) REFERENCES GalleryImage(uri) ON DELETE CASCADE
);

CREATE INDEX DetectedHand_image_idx ON DetectedHand(imageUri);
CREATE INDEX DetectedHand_score_idx ON DetectedHand(score);
CREATE INDEX DetectedHand_bbox_area_idx ON DetectedHand(bboxAreaFraction);

-- At most one user-entered (fake) hand per image. Upsert target for
-- SetUserScoreUseCase; real detections never match it (isUserRated = 0).
CREATE UNIQUE INDEX DetectedHand_user_rated_image_idx ON DetectedHand(imageUri) WHERE isUserRated = 1;

-- config: singleton filter settings row + dev-mode feature flag. The dev
-- flag lives here (same singleton row) so it persists across launches without
-- a second table; it is exposed through FeatureFlagRepository, not GalleryConfig.
CREATE TABLE config (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1 CHECK (id = 1),
    min_score REAL NOT NULL DEFAULT 0.0,
    max_score REAL NOT NULL DEFAULT 5.0,
    min_bboxAreaFraction REAL NOT NULL DEFAULT 0.0,
    sort_by TEXT AS GallerySorting NOT NULL DEFAULT 'DATE',
    date_header_mode TEXT AS DateHeaderMode NOT NULL DEFAULT 'DATES',
    dev_mode INTEGER AS Boolean NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL
);

INSERT OR IGNORE INTO config(id, min_score, max_score, min_bboxAreaFraction, sort_by, date_header_mode, dev_mode, updated_at) VALUES (1, 1.0, 5.0, 0.01, 'DATE', 'DATES', 0, 0);

-- Detail view: all matching hands with image info. The JOIN on DetectedHand
-- already restricts to images that have hands, so no handCount filter needed.
selectMatching:
SELECT gi.uri, dh.id, dh.imageUri, dh.handIndex, dh.score, dh.bboxMinX, dh.bboxMinY, dh.bboxMaxX, dh.bboxMaxY, dh.bboxAreaFraction, dh.centroidX, dh.centroidY, dh.points
FROM GalleryImage gi
JOIN DetectedHand dh ON dh.imageUri = gi.uri
JOIN config c ON c.id = 1
WHERE dh.score >= c.min_score
  AND dh.score <= c.max_score
  AND dh.bboxAreaFraction >= c.min_bboxAreaFraction
ORDER BY dh.score DESC;

-- Grid view with per-image scores. The shown scores are the user-rated
-- scores when the user overrode the rating, otherwise the distinct confident
-- real scores (drives the rating stars on each grid card). User ratings
-- always show (exempt from the filter config); real detections stay in the
-- DB for statistics. scores is a comma-separated list like "3.0,5.0".
-- Kept as-is (renamed) for comparison against the join-based rewrite below.
selectImagesWithScoresOld:
SELECT gi.uri, gi.scannedAt,
  COALESCE(
    (SELECT GROUP_CONCAT(DISTINCT f.score) FROM DetectedHand f
     WHERE f.imageUri = gi.uri AND f.isUserRated = 1),
    (SELECT GROUP_CONCAT(DISTINCT r.score) FROM DetectedHand r
     WHERE r.imageUri = gi.uri AND r.uncertain = 0
       AND r.score >= (SELECT min_score FROM config WHERE id = 1)
       AND r.score <= (SELECT max_score FROM config WHERE id = 1)
       AND r.bboxAreaFraction >= (SELECT min_bboxAreaFraction FROM config WHERE id = 1))
  ) AS scores
FROM GalleryImage gi
WHERE EXISTS (
    SELECT 1 FROM DetectedHand f WHERE f.imageUri = gi.uri AND f.isUserRated = 1
  )
  OR EXISTS (
    SELECT 1 FROM DetectedHand r
    WHERE r.imageUri = gi.uri AND r.uncertain = 0
      AND r.score >= (SELECT min_score FROM config WHERE id = 1)
      AND r.score <= (SELECT max_score FROM config WHERE id = 1)
      AND r.bboxAreaFraction >= (SELECT min_bboxAreaFraction FROM config WHERE id = 1)
  )
ORDER BY gi.scannedAt DESC;

-- Grid view with per-image scores, join-based rewrite of
-- selectImagesWithScoresOld. Same semantics: user-rated scores win when a
-- rating is present, otherwise the distinct confident real scores; images with
-- only uncertain hands (or none) are excluded. The per-image score lists are
-- precomputed in LEFT JOINed aggregates instead of correlated subqueries.
-- scores is a comma-separated list like "3.0,5.0". Note GROUP_CONCAT order
-- within the list is unspecified (the UI sorts it before display).
selectImagesWithScores:
SELECT gi.uri, gi.scannedAt,
  COALESCE(rated.scores, detected.scores) AS scores
FROM GalleryImage gi
LEFT JOIN (
    SELECT imageUri, GROUP_CONCAT(DISTINCT score) AS scores
    FROM DetectedHand
    WHERE isUserRated = 1
    GROUP BY imageUri
) rated ON rated.imageUri = gi.uri
LEFT JOIN (
    SELECT imageUri, GROUP_CONCAT(DISTINCT score) AS scores
    FROM DetectedHand
    WHERE uncertain = 0
      AND score >= (SELECT min_score FROM config WHERE id = 1)
      AND score <= (SELECT max_score FROM config WHERE id = 1)
      AND bboxAreaFraction >= (SELECT min_bboxAreaFraction FROM config WHERE id = 1)
    GROUP BY imageUri
) detected ON detected.imageUri = gi.uri
WHERE rated.imageUri IS NOT NULL OR detected.imageUri IS NOT NULL
ORDER BY gi.scannedAt DESC;

-- Uncertain grid view: distinct images whose best-scored hand is only a
-- low-confidence guess (uncertain tier), with the best guess score per image
-- so the UI can label the card. Shown separately from the confident grid so
-- the user can review and (in the future) correct those scores.
selectUncertainImagesWithScore:
SELECT gi.uri, gi.scannedAt, MAX(dh.score) AS bestGuessScore
FROM GalleryImage gi
JOIN DetectedHand dh ON dh.imageUri = gi.uri
WHERE dh.uncertain = 1
  AND NOT EXISTS (
    SELECT 1 FROM DetectedHand dh2
    WHERE dh2.imageUri = gi.uri
      AND dh2.uncertain = 0
  )
GROUP BY gi.uri, gi.scannedAt
ORDER BY gi.scannedAt DESC;

-- Config
getConfig:
SELECT * FROM config WHERE id = 1;

updateScoreRange:
UPDATE config SET min_score = ?, max_score = ?, updated_at = ? WHERE id = 1;

updateMinHandSize:
UPDATE config SET min_bboxAreaFraction = ?, updated_at = ? WHERE id = 1;

updateSorting:
UPDATE config SET sort_by = ?, updated_at = ? WHERE id = 1;

updateDateHeaderMode:
UPDATE config SET date_header_mode = ?, updated_at = ? WHERE id = 1;

-- Developer-mode feature flag (exposed through FeatureFlagRepository)
getDevMode:
SELECT dev_mode FROM config WHERE id = 1;

updateDevMode:
UPDATE config SET dev_mode = ?, updated_at = ? WHERE id = 1;

-- Gallery image CRUD. Real upsert: INSERT OR REPLACE used to delete the
-- conflicting row, which cascade-deleted the image's DetectedHand and
-- ImageEmbedding rows (their FKs point back here with ON DELETE CASCADE).
-- File metadata (createdAt/modifiedAt) always follows the system gallery;
-- scan results (status/scannedAt/detectedInMs) are only reset when the file
-- actually changed (modifiedAt differs). A row left in PROCESSING (a previous
-- scan killed mid-image) is re-queued for landmarking. DONE/FAILED results for
-- an unchanged file are kept, so re-populating on every launch does not re-run
-- landmarking for already-scanned images.
insertOrUpdateImage:
INSERT INTO GalleryImage(uri, createdAt, modifiedAt, status, scannedAt, detectedInMs)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(uri) DO UPDATE SET
  createdAt = excluded.createdAt,
  modifiedAt = excluded.modifiedAt,
  status = CASE
    WHEN modifiedAt = excluded.modifiedAt AND status = 'PROCESSING' THEN 'PENDING'
    WHEN modifiedAt = excluded.modifiedAt THEN status
    ELSE 'PENDING'
  END,
  scannedAt = CASE WHEN modifiedAt = excluded.modifiedAt THEN scannedAt ELSE NULL END,
  detectedInMs = CASE WHEN modifiedAt = excluded.modifiedAt THEN detectedInMs ELSE NULL END;

deleteImage:
DELETE FROM GalleryImage WHERE uri = ?;

selectImageByUri:
SELECT * FROM GalleryImage WHERE uri = ?;

updateImageStatus:
UPDATE GalleryImage SET status = ? WHERE uri = ?;

updateImageDone:
UPDATE GalleryImage SET status = 'DONE', detectedInMs = ? WHERE uri = ?;

selectAllImages:
SELECT * FROM GalleryImage;

selectAllUris:
SELECT uri FROM GalleryImage;

deleteByUris:
DELETE FROM GalleryImage WHERE uri IN ?;

selectUnprocessed:
SELECT * FROM GalleryImage WHERE status = 'PENDING' ORDER BY scannedAt DESC;

-- Detected hand CRUD. Plain insert for real detections. Never insert with
-- isUserRated = 1 here: the partial unique index below allows only one
-- user-rated row per image (use upsertUserRatedHand for those).
insertHand:
INSERT INTO DetectedHand(imageUri, handIndex, score, bboxMinX, bboxMinY, bboxMaxX, bboxMaxY, bboxAreaFraction, centroidX, centroidY, points, uncertain, isUserRated)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Replaces the single user-entered (fake) hand for an image, keeping real
-- detections (the old code deleted the user rating, then inserted a new one).
upsertUserRatedHand:
INSERT INTO DetectedHand(imageUri, handIndex, score, bboxMinX, bboxMinY, bboxMaxX, bboxMaxY, bboxAreaFraction, centroidX, centroidY, points, uncertain, isUserRated)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)
ON CONFLICT(imageUri) WHERE isUserRated = 1 DO UPDATE SET
  handIndex = excluded.handIndex,
  score = excluded.score,
  bboxMinX = excluded.bboxMinX,
  bboxMinY = excluded.bboxMinY,
  bboxMaxX = excluded.bboxMaxX,
  bboxMaxY = excluded.bboxMaxY,
  bboxAreaFraction = excluded.bboxAreaFraction,
  centroidX = excluded.centroidX,
  centroidY = excluded.centroidY,
  points = excluded.points,
  uncertain = excluded.uncertain,
  isUserRated = excluded.isUserRated;

-- Removes the real (detected) hands for an image before a fresh detection run
-- so rescans replace detections instead of accumulating duplicates (the
-- GalleryImage upsert no longer cascade-deletes them). User ratings are kept.
deleteRealHandsForImage:
DELETE FROM DetectedHand WHERE imageUri = ? AND isUserRated = 0;

selectHandsForImage:
SELECT * FROM DetectedHand WHERE imageUri = ? ORDER BY handIndex;

-- Bulk: delete all data (rescan)
deleteAllImages:
DELETE FROM GalleryImage;

deleteAllHands:
DELETE FROM DetectedHand;

-- SearchHistory: one row per recent CLIP search query
CREATE TABLE SearchHistory (
    query TEXT NOT NULL PRIMARY KEY,
    searchedAt INTEGER NOT NULL
);

insertSearch:
INSERT INTO SearchHistory(query, searchedAt) VALUES (?, ?)
ON CONFLICT(query) DO UPDATE SET searchedAt = excluded.searchedAt;

recentSearches:
SELECT query FROM SearchHistory ORDER BY searchedAt DESC LIMIT ?;

clearSearchHistory:
DELETE FROM SearchHistory;

-- ImageEmbedding: precomputed MobileCLIP embedding (512 floats) for every
-- gallery image with a real detected hand. Filled ahead of time by
-- PopulateImageEmbeddingsUseCase right after landmarking, so a search only
-- embeds the query text and ranks against stored vectors instead of
-- re-embedding every image on each search.
CREATE TABLE ImageEmbedding (
    uri TEXT NOT NULL PRIMARY KEY,
    embedding BLOB AS FloatArray NOT NULL,
    FOREIGN KEY (uri) REFERENCES GalleryImage(uri) ON DELETE CASCADE
);

-- Search candidates: embeddings only exist for hand images (the population
-- use case filters to images with real detections), so ranking these rows IS
-- searching through images in which a hand was detected.
selectAllEmbeddings:
SELECT uri, embedding FROM ImageEmbedding;

upsertEmbedding:
INSERT INTO ImageEmbedding(uri, embedding) VALUES (?, ?)
ON CONFLICT(uri) DO UPDATE SET embedding = excluded.embedding;

-- Removes one image's embedding (e.g. after its detections were rejected and
-- the image was marked no-hand) so search stops ranking it.
deleteEmbedding:
DELETE FROM ImageEmbedding WHERE uri = ?;

-- Hand images that don't have an embedding yet (incremental fill after
-- landmarking, or after an upgrade that introduced search). "Hand image"
-- means at least one real detection (isUserRated = 0) — what the landmarker
-- writes. A user-entered rating alone does not count.
selectImagesMissingEmbeddings:
SELECT gi.* FROM GalleryImage gi
LEFT JOIN ImageEmbedding e ON e.uri = gi.uri
WHERE EXISTS (
    SELECT 1 FROM DetectedHand dh
    WHERE dh.imageUri = gi.uri AND dh.isUserRated = 0
  )
  AND e.uri IS NULL;

deleteAllEmbeddings:
DELETE FROM ImageEmbedding;
