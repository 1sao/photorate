import isao.photorate.galleryComponent.domain.GalleryImageStatus;

-- Stores images that were / will be scanned.
CREATE TABLE GalleryImage (
    uri TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL,
    modifiedAt INTEGER NOT NULL,
    status TEXT AS GalleryImageStatus NOT NULL DEFAULT 'PENDING',
    scannedAt INTEGER,
    detectedInMs INTEGER
);

selectCount:
SELECT COUNT(*)
FROM GalleryImage
WHERE status = ?;

selectTotalCount:
SELECT COUNT(*)
FROM GalleryImage;

-- Select images that have scores from either a user-set score or a detected hand gesture.
-- Only one score is selected per image, descending by priority:
--  - A score assigned by user
--  - A confident score
--  - An uncertain score
selectScoredImages:
WITH
scoresSelection AS (
    SELECT gi.uri, gi.scannedAt, gi.createdAt, gi.modifiedAt, dh.score,
        dh.isUserRated, IIF(dh.isUncertain, 0, 1) AS isCertain,
        ROW_NUMBER() OVER (
            PARTITION BY gi.uri
            ORDER BY dh.isUserRated DESC, IIF(dh.isUncertain, 0, 1) DESC, dh.score DESC
        ) AS handRank
    FROM GalleryImage gi
    JOIN DetectedHand dh ON dh.imageUri = gi.uri
    CROSS JOIN ConfigInstance
    WHERE gi.status != 'IGNORED'
      AND dh.bboxAreaFraction >= ConfigInstance.min_bboxAreaFraction
),
bestScoreSelection AS (
    SELECT uri, scannedAt, createdAt, modifiedAt, score AS bestScore, isCertain
    FROM scoresSelection
    WHERE handRank = 1
)
SELECT bestScoredImage.uri, bestScoredImage.scannedAt, bestScoredImage.createdAt,
 bestScoredImage.modifiedAt, bestScoredImage.bestScore, bestScoredImage.isCertain = 1 AS isCertain
FROM bestScoreSelection bestScoredImage
CROSS JOIN ConfigInstance
WHERE bestScoredImage.bestScore BETWEEN ConfigInstance.min_score AND ConfigInstance.max_score
-- A trick to add a tiebreaker.
-- If sorting by score, then sort by bestScore (line 1) and then modifiedAt (line 2).
-- If NOT sorting by score, then sort by modifiedAt (line 1) and then bestScore (line 2).
ORDER BY
    IIF(ConfigInstance.sort_by = 'SCORE', bestScoredImage.bestScore, bestScoredImage.modifiedAt) DESC,
    IIF(ConfigInstance.sort_by = 'SCORE', bestScoredImage.modifiedAt, bestScoredImage.bestScore) DESC;

-- Insert a new image or update an old one. If this image has been modified after the last scan,
-- marks it as pending to be scanned again.
insertOrUpdateImage:
INSERT INTO GalleryImage(uri, createdAt, modifiedAt, status, scannedAt, detectedInMs)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(uri) DO UPDATE SET
  createdAt = excluded.createdAt,
  modifiedAt = excluded.modifiedAt,
  status = CASE
    WHEN modifiedAt = excluded.modifiedAt THEN status
    ELSE 'PENDING'
  END,
  scannedAt = CASE WHEN modifiedAt = excluded.modifiedAt THEN scannedAt ELSE NULL END,
  detectedInMs = CASE WHEN modifiedAt = excluded.modifiedAt THEN detectedInMs ELSE NULL END;

deleteImage:
DELETE FROM GalleryImage WHERE uri = ?;

selectImageByUri:
SELECT * FROM GalleryImage WHERE uri = ?;

updateImageStatus:
UPDATE GalleryImage SET status = ? WHERE uri = ?;

updateImageDone:
UPDATE GalleryImage SET status = 'DONE', detectedInMs = ?, scannedAt = ? WHERE uri = ?;

selectAllImages:
SELECT * FROM GalleryImage;

selectAllUris:
SELECT uri FROM GalleryImage;

selectImagesMissingEmbeddings:
SELECT gi.* FROM GalleryImage gi
LEFT JOIN ImageEmbedding e ON e.uri = gi.uri
WHERE EXISTS (
    SELECT 1 FROM DetectedHand dh
    WHERE dh.imageUri = gi.uri AND dh.isUserRated = 0
  )
  AND e.uri IS NULL;

deleteByUris:
DELETE FROM GalleryImage WHERE uri IN ?;

selectUnprocessed:
SELECT * FROM GalleryImage WHERE status = 'PENDING' ORDER BY scannedAt DESC;

deleteAllImages:
DELETE FROM GalleryImage;
