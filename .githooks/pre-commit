#!/usr/bin/env bash
set -euo pipefail

staged_kt_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts)$' || true)"
if [ -z "$staged_kt_files" ]; then
  exit 0
fi

include_only="$(printf '%s' "$staged_kt_files" | paste -sd: -)"
./gradlew ktfmtPrecommit --include-only="$include_only" >&2

printf '%s\n' "$staged_kt_files" | xargs git add --
